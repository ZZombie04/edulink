# Local PostgreSQL / Prisma Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/edulink"

# Required in production. Use an unpredictable value with at least 48 characters.
EDULINK_SESSION_SECRET=""

# Non-production only. Production always disables known-password demo seeds.
EDULINK_ENABLE_DEMO_SEED="false"

# Optional: set these on your host (e.g. Railway) to auto-create a
# SUPER_ADMIN account the first time `npm start` runs. See README.md
# "배포 시 자동 관리자 생성" for details. Leave unset to skip.
EDULINK_AUTO_BOOTSTRAP_ADMIN="false"
EDULINK_BOOTSTRAP_ADMIN_EMAIL=""
EDULINK_BOOTSTRAP_ADMIN_PASSWORD=""
EDULINK_BOOTSTRAP_ADMIN_NAME=""
EDULINK_BOOTSTRAP_ADMIN_PHONE=""

# Optional: set to "true" on your host to auto-run scripts/seed-dummy-data.mjs
# on every `npm start`, filling the connected Postgres with sample schools
# and teachers. See README.md "배포할 때 자동으로 채워 넣기". Leave unset to skip.
EDULINK_AUTO_SEED_DUMMY_DATA="false"
EDULINK_DUMMY_PASSWORD=""
