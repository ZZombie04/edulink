# Local PostgreSQL / Prisma Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/edulink"

# Required in production. Use an unpredictable value with at least 48 characters.
EDULINK_SESSION_SECRET=""

# Non-production only. Production always disables known-password demo seeds.
EDULINK_ENABLE_DEMO_SEED="false"
